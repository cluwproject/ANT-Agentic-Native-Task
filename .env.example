# ════════════════════════════════════════════════════════════════════
# ANT — AGENTIC NATIVE TASK × MINDBY (ENVIRONMENT TEMPLATE)
# ════════════════════════════════════════════════════════════════════

USER_NAME=Ard

# ── MODEL PROVIDER ──────────────────────────────────────────────────
AI_PROVIDER=ollama
AI_MODEL=gpt-oss:120b-cloud
AI_BASE_URL=http://localhost:11434/v1
BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=gpt-oss:120b-cloud

# ── COCKROACHDB SERVERLESS (Persistent Memory Layer) ────────────────
DATABASE_URL=postgresql://<user>:<password>@<cluster>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
MEMORY_VAULT_MODE=cloud

# ── AWS BEDROCK (Embeddings & Inference) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── WEB SEARCH API ──────────────────────────────────────────────────
TAVILY_API_KEY=

# ── RUNTIME FLAGS ───────────────────────────────────────────────────
ANT_MODE=agentic
ANT_MEMORY=true
ANT_AUTO_VERIFY=true
ANT_SELF_HEAL=true
ANT_MAX_ITERATIONS=12
ANT_APPROVAL_MODE=smart
ANT_RISK_THRESHOLD=MEDIUM
