# ═══════════════════════════════════
# ANT — Agentic Native Task Config
# ═══════════════════════════════════

# Model Provider (pilih salah satu: ollama | gemini | openai | anthropic)
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
AI_BASE_URL=http://localhost:11434

# Mode ANT
ANT_MODE=agentic
ANT_MEMORY=true
ANT_AUTO_VERIFY=true
ANT_SELF_HEAL=true

# Batas Eksekusi
ANT_MAX_ITERATIONS=12
ANT_APPROVAL_MODE=smart

# Keamanan
ANT_RISK_THRESHOLD=MEDIUM
ANT_BLAST_RADIUS_CHECK=true
