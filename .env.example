# ════════════════════════════════════════════════════════════════════
# ANT — AGENTIC NATIVE TASK  (ENVIRONMENT CONFIGURATION)
# ════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below
#   3. Never commit your .env to Git — only .env.example is safe to push
#
# QUICKSTART (Offline / Termux friendly — no API key needed):
#   AI_PROVIDER=ollama
#   AI_MODEL=qwen2.5:0.5b
#   ANT_SWARM_MODEL=qwen2.5:0.5b
#   (Leave everything else as-is)
#
# ════════════════════════════════════════════════════════════════════

# ── STEP 1: Your Identity ────────────────────────────────────────────
# Your name — ANT will greet you and personalize responses.
# Change "YourName" to your own name.
USER_NAME=YourName

# ── STEP 2: Choose Your AI Provider ─────────────────────────────────
# Pick ONE of the options below and uncomment it.
# Delete or comment out the others.

# OPTION A: Ollama (Local / Offline — FREE, no API key needed)
# Run: ollama pull qwen2.5:0.5b  before starting ANT
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:0.5b
AI_BASE_URL=http://localhost:11434/v1
BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=qwen2.5:0.5b

# OPTION B: Google Gemini (Cloud — fast, generous free tier)
# Get API key at: https://aistudio.google.com/app/apikey
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your_gemini_key_here

# OPTION C: Anthropic Claude (Cloud — best reasoning)
# Get API key at: https://console.anthropic.com/
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=your_anthropic_key_here

# OPTION D: OpenAI (Cloud — widely supported)
# Get API key at: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_key_here

# ── STEP 3: Gray Unit Swarm Model ───────────────────────────────────
# The model used by the 5 ANT-CYBER-CORPS security units (/swarm command).
# Keep this LIGHTWEIGHT — especially on Termux/Android.
#
# Recommended by device:
#   Android (Termux)  → qwen2.5-coder:0.5b  (default, safe)
#   PC/Laptop 8GB RAM → qwen2.5-coder:3b    (much smarter)
#   PC/Laptop 16GB+   → qwen2.5-coder:7b    (best results)
#
ANT_SWARM_MODEL=qwen2.5:0.5b

# Advanced: Override model per Gray Unit (optional, leave commented if unsure)
# ANT_GRAY_1_MODEL=qwen2.5-coder:3b   # Memory & Logic Guardian
# ANT_GRAY_2_MODEL=qwen2.5-coder:3b   # Injection Sifter (SQL/XSS/CMDi)
# ANT_GRAY_3_MODEL=qwen2.5-coder:3b   # Auth & Identity Architect (IDOR/JWT)
# ANT_GRAY_4_MODEL=qwen2.5-coder:3b   # Supply Chain Sentinel (CVE/deps)
# ANT_GRAY_5_MODEL=qwen2.5-coder:3b   # Cloud & Config Auditor (.env/IAM)

# ── STEP 4: Persistent Memory (Optional) ────────────────────────────
# Connect to CockroachDB for cloud-synced memory across devices.
# If left empty, ANT uses local JSON files (works perfectly offline).
#
# Get a free DB at: https://cockroachlabs.cloud/
# DATABASE_URL=postgresql://<user>:<password>@<cluster>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

MEMORY_VAULT_MODE=local
# local = use local JSON files only (recommended for first-time setup)
# cloud = sync to CockroachDB (requires DATABASE_URL above)

# ── STEP 5: Optional API Keys ────────────────────────────────────────
# Only fill these in if you need the specific feature.

# Web search tool (get key at: https://tavily.com)
# TAVILY_API_KEY=

# AWS Bedrock (only if using AWS for embeddings/inference)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Advanced Runtime Flags (Leave as-is for most users) ─────────────
ANT_MODE=agentic
ANT_MEMORY=true
ANT_AUTO_VERIFY=true
ANT_SELF_HEAL=true
ANT_MAX_ITERATIONS=12
ANT_APPROVAL_MODE=smart
ANT_RISK_THRESHOLD=MEDIUM

# Swarm safety limits (do not increase on Termux/Android)
ANT_SLM_MAX_FILE_KB=24
ANT_SLM_MAX_FILES_PER_UNIT=8
