# ════════════════════════════════════════════════════════════════════
# ANT — AGENTIC NATIVE TASK × MINDBY (ENVIRONMENT TEMPLATE)
# Salin file ini ke `.env` dan isi nilainya.
# JANGAN commit .env ke Git — hanya .env.example yang boleh dipush.
# ════════════════════════════════════════════════════════════════════

USER_NAME=Ard

# ── COMMANDER MODEL (Model Utama — LLM besar) ───────────────────────
# Model yang digunakan oleh ANT Commander untuk reasoning kompleks.
# Bisa diisi model cloud atau model Ollama lokal yang besar.
AI_PROVIDER=ollama
AI_MODEL=gpt-oss:120b-cloud
AI_BASE_URL=http://localhost:11434/v1
BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=gpt-oss:120b-cloud

# ── SWARM: ANT-CYBER-CORPS GRAY UNIT MODELS (0.5B SLM) ─────────────
# Model untuk 5 pasukan Gray Unit (sub-agen kecil 0.5B).
# Model ini HARUS ringan — jangan gunakan model > 1.5B di sini
# agar tidak crash di Termux. Disarankan: qwen2.5:0.5b
#
# ANT_SWARM_MODEL = fallback default jika unit-specific tidak diset.
#
ANT_SWARM_MODEL=qwen2.5:0.5b

# Opsional: Override per-unit jika setiap unit punya model beda.
# Jika tidak diset, unit akan menggunakan ANT_SWARM_MODEL di atas.
#
# ANT_GRAY_1_MODEL=qwen2.5:0.5b   # Memory & Logic Guardian
# ANT_GRAY_2_MODEL=qwen2.5:0.5b   # Injection Sifter (SQL/XSS/CMDi)
# ANT_GRAY_3_MODEL=qwen2.5:0.5b   # Auth & Identity Architect (IDOR/JWT)
# ANT_GRAY_4_MODEL=qwen2.5:0.5b   # Supply Chain Sentinel (CVE/deps)
# ANT_GRAY_5_MODEL=qwen2.5:0.8b   # Cloud & Config Auditor (.env/IAM)
#
# CATATAN: Gray Unit menggunakan analisis statis berbasis regex rule
# sebagai engine utamanya. Model 0.5B hanya digunakan untuk ringkasan
# dan tidak akan diberikan file > 24KB untuk menghindari OOM / halusinasi.

# ── COCKROACHDB SERVERLESS (Persistent Memory Layer) ────────────────
# [CATATAN] Hubungan ke cloud CockroachDB memerlukan DATABASE_URL aktif.
# Jika tidak diisi, sistem otomatis fallback ke Local File Vault (offline).
# Memories yang disimpan saat offline akan masuk ke antrian pending_sync.json
# dan bisa disinkronkan ke cloud dengan perintah: /sync
DATABASE_URL=postgresql://<user>:<password>@<cluster>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
MEMORY_VAULT_MODE=cloud
# Nilai MEMORY_VAULT_MODE: cloud | local
# cloud = prioritaskan CockroachDB, fallback ke local jika gagal
# local = paksa local JSON vault, skip cloud sama sekali

# ── AWS BEDROCK (Embeddings & Inference — Opsional) ─────────────────
# [CATATAN] Hanya diperlukan jika menggunakan provider Bedrock.
# Embedding utama menggunakan nomic-embed-text via Ollama (offline-first).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── WEB SEARCH API (Opsional) ────────────────────────────────────────
# [CATATAN] Digunakan oleh tool web_search. Kosongkan jika tidak ada akses internet.
# TAVILY_API_KEY=

# ── RUNTIME FLAGS ────────────────────────────────────────────────────
ANT_MODE=agentic
ANT_MEMORY=true
ANT_AUTO_VERIFY=true
ANT_SELF_HEAL=true
ANT_MAX_ITERATIONS=12
ANT_APPROVAL_MODE=smart
ANT_RISK_THRESHOLD=MEDIUM

# ── SWARM SAFETY LIMITS ──────────────────────────────────────────────
# Batas ukuran file yang boleh dibaca oleh Gray Unit SLM.
# File yang melebihi batas ini akan di-SKIP dan dilaporkan ke Commander.
# Default: 24576 bytes (24 KB). Jangan naikkan di atas 65536 (64 KB) untuk Termux.
ANT_SLM_MAX_FILE_KB=24
# Maksimum file yang diperiksa per Gray Unit per misi.
# Default: 8. Jaga agar tidak lebih dari 15 untuk menghindari RAM overload.
ANT_SLM_MAX_FILES_PER_UNIT=8
