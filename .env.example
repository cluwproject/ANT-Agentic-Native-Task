# ════════════════════════════════════════════════════════════════════
# ANT — AGENTIC NATIVE TASK  |  ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════════
#
# SETUP:
#   1.  cp .env.example .env
#   2.  Fill in ONE provider block (Step 2) — comment out the rest
#   3.  NEVER commit your .env  (it is already in .gitignore)
#
# ════════════════════════════════════════════════════════════════════

# ── Step 1 · Identity ─────────────────────────────────────────────
USER_NAME=YourName             # ANT greets you by this name


# ── Step 2 · AI Provider — pick ONE, comment out the rest ─────────

# ┌──────────────────────────────────────────────────────────────────
# │ A. OpenRouter  (Recommended — free & paid models, no extra setup)
# │    Get key: https://openrouter.ai/keys
# │    Free models: z-ai/glm-5.2:free  |  google/gemma-3-27b-it:free
# └──────────────────────────────────────────────────────────────────
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-or-v1-...           # same key, needed for OpenAI SDK
# AI_MODEL=z-ai/glm-5.2:free            # or any model slug from openrouter.ai
# CUSTOM_MODEL=z-ai/glm-5.2:free

# ┌──────────────────────────────────────────────────────────────────
# │ B. Google Gemini  (Cloud — generous free tier)
# │    Get key: https://aistudio.google.com/app/apikey
# └──────────────────────────────────────────────────────────────────
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# AI_MODEL=gemini-2.0-flash
# CUSTOM_MODEL=gemini-2.0-flash

# ┌──────────────────────────────────────────────────────────────────
# │ C. Anthropic Claude  (Cloud — best reasoning)
# │    Get key: https://console.anthropic.com/
# └──────────────────────────────────────────────────────────────────
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-haiku-20241022
# CUSTOM_MODEL=claude-3-5-haiku-20241022

# ┌──────────────────────────────────────────────────────────────────
# │ D. OpenAI  (Cloud)
# │    Get key: https://platform.openai.com/api-keys
# └──────────────────────────────────────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# CUSTOM_MODEL=gpt-4o-mini

# ┌──────────────────────────────────────────────────────────────────
# │ E. Ollama  (Local / Offline — completely FREE, no API key)
# │    Install: https://ollama.com  then: ollama pull qwen2.5:0.5b
# └──────────────────────────────────────────────────────────────────
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:0.5b
# CUSTOM_MODEL=qwen2.5:0.5b


# ── Step 3 · Swarm Security Model ─────────────────────────────────
# Model used by /swarm (ANT-CYBER-CORPS gray units).
# Keep this LIGHTWEIGHT on mobile / Termux.
#   Termux/Android → qwen2.5:0.5b    (default, ~500 MB)
#   PC 8 GB RAM    → qwen2.5-coder:3b
#   PC 16 GB+ RAM  → qwen2.5-coder:7b
#
ANT_SWARM_MODEL=qwen2.5:0.5b

# Per-unit override (optional — leave commented if unsure)
# ANT_GRAY_1_MODEL=qwen2.5-coder:3b   # Memory & Logic Guardian
# ANT_GRAY_2_MODEL=qwen2.5-coder:3b   # Injection Sifter (SQL/XSS/CMDi)
# ANT_GRAY_3_MODEL=qwen2.5-coder:3b   # Auth & Identity Architect
# ANT_GRAY_4_MODEL=qwen2.5-coder:3b   # Supply Chain Sentinel (CVE/deps)
# ANT_GRAY_5_MODEL=qwen2.5-coder:3b   # Cloud & Config Auditor


# ── Step 4 · Persistent Memory (Optional) ─────────────────────────
# Leave DATABASE_URL empty to use local storage (default, works offline).
# For cloud sync across devices, connect a free CockroachDB instance:
#   https://cockroachlabs.cloud/
#
# DATABASE_URL=postgresql://<user>:<password>@<cluster>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
MEMORY_VAULT_MODE=local
# local  → local SQLite vault (recommended for first-time setup)
# cloud  → sync to CockroachDB (requires DATABASE_URL above)


# ── Step 5 · Optional Tools ───────────────────────────────────────

# Tavily web search (get key: https://tavily.com)
# TAVILY_API_KEY=tvly-...

# AWS Bedrock (only if using AWS for embeddings or inference)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1


# ── ANT Runtime Flags — leave as-is unless you know what you're doing ──
ANT_MODE=agentic
ANT_MEMORY=true
ANT_AUTO_VERIFY=true
ANT_SELF_HEAL=true
ANT_MAX_ITERATIONS=12
ANT_APPROVAL_MODE=smart
ANT_RISK_THRESHOLD=MEDIUM
ANT_BLAST_RADIUS_CHECK=true

# Swarm resource limits (do NOT increase on Termux/Android)
ANT_SLM_MAX_FILE_KB=24
ANT_SLM_MAX_FILES_PER_UNIT=8
