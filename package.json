{
  "name": "ant-cli",
  "version": "0.1.0",
  "description": "ANT — Agentic Native Task. You Ask. ANT Acts.",
  "type": "module",
  "bin": {
    "ant": "./bin/ant.js"
  },
  "main": "./bin/ant.js",
  "files": [
    "bin",
    "dist",
    "src",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "ant": "node bin/ant.js",
    "dev": "node scripts/ant-supervisor.mjs npx tsx watch src/core/cli.ts",
    "start": "tsx src/core/cli.ts",
    "start:dev": "node scripts/ant-supervisor.mjs npx tsx watch src/core/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "agent",
    "ai",
    "cli",
    "ant",
    "agentic",
    "code-agent",
    "task-automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.16.0",
    "@types/pg": "^8.21.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.0.0",
    "js-yaml": "^5.2.3",
    "marked": "^5.0.0",
    "marked-terminal": "^6.0.0",
    "openai": "^7.4.0",
    "ora": "^7.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "uuid": "^14.0.1"
  },
  "optionalDependencies": {
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0"
  }
}
