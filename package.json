{
  "name": "ant-cli",
  "version": "0.3.5",
  "description": "ANT — Agentic Native Task. You Ask. ANT Acts.",
  "type": "module",
  "bin": {
    "ant": "./bin/ant.js"
  },
  "main": "./bin/ant.js",
  "files": [
    "bin",
    "dist",
    "src",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "ant": "node bin/ant.js",
    "dev": "node scripts/ant-supervisor.mjs npx tsx watch src/core/cli.ts",
    "start": "tsx src/core/cli.ts",
    "start:dev": "node scripts/ant-supervisor.mjs npx tsx watch src/core/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "ci": "npm run typecheck && npm run build && npm run test:unit && npm run lint",
    "clean": "rm -rf dist",
    "check:build": "tsc -p tsconfig.build.json --noEmit --pretty",
    "check:drift": "npm run build && git diff --stat dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "agent",
    "ai",
    "cli",
    "ant",
    "agentic",
    "code-agent",
    "task-automation"
  ],
  "author": "Ard <ard@ant.local>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cluwproject/ANT-Agentic-Native-Task/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cluwproject/ANT-Agentic-Native-Task.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.16.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.0.0",
    "js-yaml": "^5.2.3",
    "marked": "^5.0.0",
    "marked-terminal": "^6.0.0",
    "openai": "^7.4.0",
    "ora": "^7.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "uuid": "^14.0.1"
  },
  "optionalDependencies": {
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
